{
  "title": "builds a pulley",
  "sprites": {
    "gear": {
      "color": "ink",
      "poses": {
        "rest": {"every": 1, "frames": [["{+}"]]}
      }
    },
    "rope": {
      "color": "sand",
      "poses": {
        "rest": {"every": 1, "frames": [["@~"]]}
      }
    },
    "cork": {
      "color": "sun",
      "poses": {
        "rest": {"every": 1, "frames": [["[o]"]]}
      }
    },
    "assembly": {
      "color": "wood",
      "poses": {
        "base": {"every": 1, "frames": [["  ___"]]},
        "half": {"every": 1, "frames": [["  ._.", " / O \\", " |   |", " |  .o.", " J"]]},
        "done": {"every": 1, "frames": [["  ___", " / O \\", " |   |", " |  [o]", " J"]]},
        "use": {"every": 0.35, "frames": [["  ___", " / O \\", " |  [o]", " |   ", " J"], ["  ___", " / O \\", " |   |", " |  [o]", " J"]]}
      }
    }
  },
  "cast": {
    "clawd": {"at": [0.64, 0.7]},
    "machine": {"sprite": "assembly", "at": [0.64, 0.7], "pose": "base", "hidden": true},
    "gear": {"sprite": "gear", "at": [0.12, 0.78], "pose": "rest"},
    "rope": {"sprite": "rope", "at": [0.27, 0.78], "pose": "rest"},
    "cork": {"sprite": "cork", "at": [0.42, 0.78], "pose": "rest"}
  },
  "beats": [
    {"for": 0.4, "clawd": {"pose": "idle", "say": "let us build"}},
    {"for": 0.7, "clawd": {"to": [0.12, 0.78], "pose": "walk"}},
    {"for": 1.2, "clawd": {"to": [0.43, 0.7], "pose": "walk"}, "gear": {"to": [0.52, 0.7]}},
    {"for": 0.7, "clawd": {"to": [0.27, 0.78], "pose": "walk"}},
    {"for": 1.2, "clawd": {"to": [0.43, 0.7], "pose": "walk"}, "rope": {"to": [0.57, 0.7]}},
    {"for": 0.7, "clawd": {"to": [0.42, 0.78], "pose": "walk"}},
    {"for": 1.2, "clawd": {"to": [0.43, 0.7], "pose": "walk"}, "cork": {"to": [0.62, 0.7]}},
    {"for": 1, "clawd": {"pose": "type", "say": "fit the pieces"}, "machine": {"show": true, "pose": "base"}, "gear": {"show": false}, "rope": {"show": false}, "cork": {"show": false}},
    {"for": 1, "clawd": {"pose": "type"}, "machine": {"pose": "half"}},
    {"for": 1, "clawd": {"pose": "idle", "say": "ready"}, "machine": {"pose": "done"}},
    {"for": 1.2, "clawd": {"pose": "type", "say": "pull the rope"}, "machine": {"pose": "use"}},
    {"for": 0.8, "clawd": {"pose": "wave", "say": "made it"}, "machine": {"pose": "done"}}
  ]
}
